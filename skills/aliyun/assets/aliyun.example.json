{
  "version": 1,
  "project": "my-app",
  "region": "cn-hangzhou",
  "accountId": "1234567890123456",
  "frontend": {
    "bucket": "replace-with-your-unique-bucket",
    "dir": "frontend/dist",
    "build": { "cwd": "frontend", "command": ["npm", "run", "build"] },
    "domain": "app.example.com",
    "spa": true
  },
  "backend": {
    "functionName": "my-app-api",
    "codeDir": "backend/dist",
    "build": { "cwd": "backend", "command": ["npm", "run", "build"] },
    "domain": "api.example.com",
    "runtime": "custom.debian10",
    "command": ["/var/fc/lang/nodejs20/bin/node", "server.mjs"],
    "port": 9000,
    "cpu": 0.35,
    "memorySize": 512,
    "timeout": 60,
    "instanceConcurrency": 10,
    "maxInstances": 5,
    "environment": { "NODE_ENV": "production" },
    "envFrom": {}
  },
  "dns": { "zone": "example.com", "ttl": 600 },
  "tls": {
    "certFile": ".aliyun/tls/fullchain.pem",
    "keyFile": ".aliyun/tls/privkey.pem"
  }
}
